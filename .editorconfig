root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{kt,kts}]
max_line_length = 120
# Pinned explicitly: the Gradle plugin uses ktlint_official and the CLI uses
# intellij_idea. Without this, local checks and CI disagree.
ktlint_code_style = ktlint_official
# @Composable functions are PascalCase by Compose convention.
ktlint_function_naming_ignore_when_annotated_with = Composable
# File names are fixed by the specification (GameConstants.kt, Physics.kt…), even when
# one of them holds a single top-level declaration.
ktlint_standard_filename = disabled

[*.{yml,yaml,xml,toml,json}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false
