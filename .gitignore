# Compiled class file
*.class

# Log file
*.log

# BlueJ files
*.ctxt

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# Package Files #
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# virtual machine crash logs, see http://www.java.com/en/download/help/error_hotspot.xml
hs_err_pid*
replay_pid*

# Kotlin Gradle plugin data, see https://kotlinlang.org/docs/whatsnew20.html#new-directory-for-kotlin-data-in-gradle-projects
.kotlin/
# --- Gradle / Android ---
.gradle/
build/
local.properties
captures/
.cxx/
*.apk
*.aab
*.ap_
*.dex
.idea/
*.iml
.DS_Store

# The wrapper IS versioned: it is what pins the same Gradle version in CI.
!gradle/wrapper/gradle-wrapper.jar

# --- Signing ---
# The upload key and its passwords never enter the repository. CI gets them from GitHub
# secrets; a machine building a signed release locally keeps them in keystore.properties,
# which lives here and is never committed.
*.jks
*.keystore
keystore.properties

# Python
__pycache__/
*.py[cod]
